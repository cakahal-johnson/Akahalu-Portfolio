# ============================================================
# Akahalu Portfolio Frontend
# ============================================================

# Public URL of the Next.js application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-accessible public FastAPI URL.
#
# In production this should use the public HTTPS address,
# for example:
# https://portfolio.example.com/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Public API client timeout.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Server-only FastAPI address used by:
# - Next.js server components
# - SSR requests
# - Admin BFF route handlers
#
# Local:
# http://127.0.0.1:8000/api/v1
#
# Production Docker network:
# http://backend:8000/api/v1
BACKEND_API_URL=http://127.0.0.1:8000/api/v1