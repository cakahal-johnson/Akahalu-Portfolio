# =============================================================================
# Application
# =============================================================================

APP_NAME="Akahalu Portfolio API"
APP_VERSION="1.0.0"

ENVIRONMENT="local"
DEBUG=false

API_V1_PREFIX="/api/v1"

BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000


# =============================================================================
# Frontend and CORS
# =============================================================================

ALLOWED_ORIGINS=["http://localhost:3000"]


# =============================================================================
# PostgreSQL
# =============================================================================

DATABASE_URL="postgresql+psycopg://portfolio_user:portfolio_password@127.0.0.1:5432/portfolio_db"

# Leave empty during normal development unless a separate test database URL
# is required.
TEST_DATABASE_URL="postgresql+psycopg://portfolio_user:portfolio_password@127.0.0.1:5432/portfolio_test_db"

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30


# =============================================================================
# Redis
# =============================================================================

REDIS_URL="redis://:portfolio_redis_password@127.0.0.1:6379/0"


# =============================================================================
# JWT Authentication
# =============================================================================

# Generate a secure value:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="replace-with-a-secure-random-secret"

JWT_ALGORITHM="HS256"
JWT_ISSUER="akahalu-portfolio-api"
JWT_AUDIENCE="akahalu-portfolio-web"

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30


# =============================================================================
# Contact Security
# =============================================================================

# Generate a different secure value:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
CONTACT_HASH_SECRET_KEY="replace-with-a-different-secure-random-secret"

CONTACT_DUPLICATE_WINDOW_MINUTES=15
CONTACT_USER_AGENT_MAX_LENGTH=500


# =============================================================================
# Account Lifecycle
# =============================================================================

EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=60


# =============================================================================
# Login Security
# =============================================================================

MAXIMUM_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15