# ============================================================
# Akahalu Portfolio - Production Environment Template
#
# Copy this file to:
# infrastructure/production.env
#
# Never commit production.env.
# ============================================================


# ============================================================
# Compose
# ============================================================

COMPOSE_PROJECT_NAME=akahalu-portfolio
IMAGE_TAG=local

# Local production-stack smoke test only.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080


# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

DATABASE_URL=postgresql+psycopg://portfolio_user:replace-with-the-same-postgres-password@postgres:5432/portfolio_db

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30


# ============================================================
# Redis
# ============================================================

REDIS_PASSWORD=replace-with-a-url-safe-random-password

REDIS_URL=redis://:replace-with-the-same-redis-password@redis:6379/0


# ============================================================
# Backend
# ============================================================

APP_NAME="Akahalu Portfolio API"
APP_VERSION="1.0.0"

ENVIRONMENT=production
DEBUG=false

API_V1_PREFIX=/api/v1
API_DOCS_ENABLED=false

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Replace these hosts before real deployment.
ALLOWED_ORIGINS=["https://portfolio.example.com"]

# localhost and 127.0.0.1 are required for the local
# production-container smoke test and internal health checks.
TRUSTED_HOSTS=["portfolio.example.com","www.portfolio.example.com","localhost","127.0.0.1","backend"]

JWT_SECRET_KEY=replace-with-a-high-entropy-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=akahalu-portfolio-api
JWT_AUDIENCE=akahalu-portfolio-web

CONTACT_HASH_SECRET_KEY=replace-with-a-different-high-entropy-secret

CONTACT_DUPLICATE_WINDOW_MINUTES=15
CONTACT_USER_AGENT_MAX_LENGTH=500

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=60

MAXIMUM_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15


# ============================================================
# Frontend
# ============================================================

# These localhost values are for the local production-stack
# smoke test only.
NEXT_PUBLIC_APP_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Private server-to-server Docker address.
BACKEND_API_URL=http://backend:8000/api/v1